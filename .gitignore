# ---------------------------------------------------------------------------
# Environment & secrets — NEVER commit real environment files or credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
.wrangler/
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------------------------------------------------------------------------
# PHP / Laravel (backend/)
# ---------------------------------------------------------------------------
/vendor/
/node_modules/
backend/.phpunit.result.cache
backend/.herd/
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/storage/app/public/*
backend/bootstrap/cache/*.php
backend/public/storage
backend/.phpstorm.meta.php
backend/_ide-helper.php
backend/.nova/

# ---------------------------------------------------------------------------
# Node / Vue / Vite (frontend/)
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/*.local
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Test & coverage output
# ---------------------------------------------------------------------------
coverage/
.phpcoverage
**/coverage/
test-results/
playwright-report/

# ---------------------------------------------------------------------------
# Build artifacts & local runtime files
# ---------------------------------------------------------------------------
*.log
*.pid
*.seed
*.out
*.err
/storage/*.sqlite
/storage/*.sqlite3

# ---------------------------------------------------------------------------
# OS / IDE / editor
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.history/

# ---------------------------------------------------------------------------
# Local databases / dumps / exports
# ---------------------------------------------------------------------------
*.dump
*.sql.gz
*.backup
