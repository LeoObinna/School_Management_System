# ===========================================================================
# SMS Environment Example (root level)
# Copy to .env inside the Codespace or use Codespace Secrets.
# NEVER commit .env or real credentials.
# ===========================================================================

# --- Application ---
APP_NAME="School Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# --- Frontend ---
# In Codespaces, use the forwarded port URL for Vite HMR.
# Replace CODESPACE_NAME with your Codespace name (auto-injected).
FRONTEND_URL=${CODESPACE_NAME}-5173.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}

# --- Database (PostgreSQL 16 via docker-compose in Codespace) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sms
DB_USERNAME=sms
DB_PASSWORD=sms_secret

# For CI or external managed PostgreSQL, override:
# DB_HOST=your-managed-pg.host
# DB_PORT=5432
# DB_DATABASE=sms_staging
# DB_USERNAME=your_user
# DB_PASSWORD=your_password

# --- Redis (via docker-compose in Codespace) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# For external managed Redis, override:
# REDIS_HOST=your-managed-redis.host
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sms-staging
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_USE_PATH_STYLE_ENDPOINT=true
R2_DEFAULT_REGION=auto

# For production, use a separate bucket:
# R2_BUCKET=sms-production

# --- Laravel Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8000
SESSION_DOMAIN=localhost

# --- Mail (optional in dev) ---
MAIL_MAILER=log

# --- Cloudflare (optional for dev) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
