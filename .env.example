# ===========================================================================
# SMS — Root Environment Example (documentation pointer)
#
# The Nuxt app has its own env template at app/.env.example.
# Copy that to app/.env (never commit real values).
#
# Local secrets live only in app/.env.
# Staging/production secrets are set with:
#   wrangler secret put <NAME> -e staging
#   wrangler secret put <NAME> -e production
# ===========================================================================

# --- Database (PostgreSQL) ---
# Direct connection string for local dev, migrations and seeds.
# Workers use the HYPERDRIVE binding instead (see app/wrangler.toml).
DATABASE_URL=postgresql://sms:sms_secret@localhost:5432/sms

# --- Session / Auth ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- R2 ---
# No S3 credentials in the app: the Worker uses the R2_BUCKET binding.
# The bucket name is declared per environment in app/wrangler.toml.
