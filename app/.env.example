# ===========================================================================
# SMS Nuxt App — Environment Example
# Copy to .env (never commit real values).
# Production/staging secrets are set with `wrangler secret put`, never here.
#
# WARNING: DATABASE_URL and SESSION_SECRET are read at RUNTIME only (the
# Nitro 'request' plugin bridges bindings/process.env into runtimeConfig;
# nuxt.config.ts ships empty defaults so they never get compiled into the
# Worker bundle). Keep this file free of real values — *.example is
# committed to Git.
#
# Phase 1 (D1 migration, 2026-09-22): D1 is the authoritative target
# database per the v2.0 spec package (docs/spec/v2/). PostgreSQL/
# Hyperdrive remain as the live staging fallback until D1 staging
# passes acceptance (Phase 6). DATABASE_URL/STAGING_DATABASE_URL below
# are LEGACY and will be removed in Phase 6.
# ===========================================================================

# --- Database (LEGACY PostgreSQL fallback) ---
# Used only by:
#   - `nuxt dev` (Phase 1 keeps PG for local dev until Phase 2 rewrites
#     the schema to D1/SQLite, after which local dev moves to
#     `wrangler dev` + the local D1 binding in wrangler.toml).
#   - drizzle-kit PG migrations and the seeder, until Phase 2 regenerates
#     the schema as SQLite DDL and `wrangler d1 migrations` replaces
#     drizzle-kit migrate.
# Local development uses Postgres.app: create the database once with
#   createdb -h localhost -p 5432 -U "$USER" sms_dev
# (Postgres.app uses trust auth on localhost — no password needed).
# In Workers, the HYPERDRIVE binding is used instead — see wrangler.toml
# (localConnectionString for `wrangler dev`, per-environment ids for deploys).
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@127.0.0.1:5432/sms_dev

# Staging managed PostgreSQL (Neon) — LEGACY FALLBACK ONLY. Used for
# running staging migrations/seed from this Mac against the live
# PG-backed staging Worker. Deployed Workers never read this; they
# reach Postgres via the HYPERDRIVE binding. Use the DIRECT host (no
# "-pooler" in the hostname). Example shell usage:
#   DATABASE_URL="$STAGING_DATABASE_URL" npm run db:migrate
# A full remote reset must drop both the `public` and `drizzle` schemas.
# Decommissioned after Phase 6 D1 staging acceptance.
STAGING_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/sms_staging?sslmode=require

# --- D1 dispatch switch (Phase 2 onwards) ---
# When set to 'true' (via `wrangler secret put SMS_USE_D1 -e staging`),
# db.ts dispatches the request-scoped Drizzle client to env.DB (D1)
# instead of env.HYPERDRIVE (PostgreSQL). Defaults to false throughout
# Phase 1; Phase 2 will flip the default to true after the schema is
# rewritten and the query dialect migration is complete. NEVER set in
# plain Node dev (no D1 binding exists; would force the D1 path to
# throw a configuration error).
# SMS_USE_D1=false

# --- Session / Auth ---
# Generate a long random value (e.g. `openssl rand -base64 48`).
SESSION_SECRET=change-me-to-a-long-random-string
# Password for demo accounts created by `npm run db:seed` (optional).
SEED_PASSWORD=password123
# Dev ONLY: have forgot-password return the reset token until the
# Queues/email integration exists (Phase 10). Never true in staging/prod.
EXPOSE_RESET_TOKENS=false

# --- Cloudflare R2 (object storage) ---
# No S3-compatible credentials are needed by the Worker: object storage
# is accessed exclusively through the R2_BUCKET binding in wrangler.toml.
# (S3 API tokens are only for external backup/tooling, never for the app.)

# --- App ---
NUXT_PUBLIC_API_BASE_URL=/api/v1
