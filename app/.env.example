# ===========================================================================
# SMS Nuxt App — Environment Example
# Copy to .env (never commit real values).
# Production secrets are set with `wrangler secret put -e production`, never here.
#
# WARNING: SESSION_SECRET is read at RUNTIME only (the Nitro 'request'
# plugin bridges bindings/process.env into runtimeConfig; nuxt.config.ts
# ships empty defaults so secrets never get compiled into the Worker
# bundle). Keep this file free of real values — *.example is committed
# to Git.
#
# Database: Cloudflare D1 (SQLite) only. The `DB` binding is declared in
# wrangler.toml [[d1_databases]] and is reached via the D1 binding in
# Workers and via wrangler's getPlatformProxy in `nuxt dev`. State is
# persisted under .wrangler/state/v3/d1/. NO DATABASE URL OR ENV VAR
# IS NEEDED — apply schema with `npm run db:migrate` and seed with
# `npm run db:seed`.
# ===========================================================================

# --- Session / Auth ---
# Generate a long random value (e.g. `openssl rand -base64 48`).
SESSION_SECRET=change-me-to-a-long-random-string
# Password for demo accounts created by `npm run db:seed` (optional).
SEED_PASSWORD=password123
# Dev ONLY: have forgot-password return the reset token until the
# Queues/email integration exists (Phase 10). Never true in production.
EXPOSE_RESET_TOKENS=false

# --- Cloudflare R2 (object storage) ---
# No S3-compatible credentials are needed by the Worker: object storage
# is accessed exclusively through the R2_BUCKET binding in wrangler.toml.
# (S3 API tokens are only for external backup/tooling, never for the app.)

# --- App ---
NUXT_PUBLIC_API_BASE_URL=/api/v1
