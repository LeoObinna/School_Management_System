{
  "name": "SMS Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [5173, 8000, 5432, 6379],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server" },
    "8000": { "label": "Laravel API" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": "sudo chown -R vscode:vscode /workspace && sudo chown -R vscode:vscode /workspace/frontend/node_modules 2>/dev/null; true",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "bmewburn.vscode-intelephense-client",
        "ryannlindve.vscode-tailwindcss-intellisense",
        "GitHub.copilot",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "php.validate.executablePath": "/usr/local/bin/php",
        "intelephense.environment.phpVersion": "8.4",
        "tailwindCSS.includeLanguages": {
          "vue": "html"
        }
      }
    }
  }
}
