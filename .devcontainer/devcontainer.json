{
  "name": "SMS Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/php:1": {
      "version": "8.4",
      "extensions": "mbstring xml curl zip pgsql sqlite3 bcmath intl gd opcache redis"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5173, 8000, 5432, 6379],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server" },
    "8000": { "label": "Laravel API" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": "sudo service postgresql start && sudo service redis-server start",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "bmewburn.vscode-intelephense-client",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "intelephense.environment.phpVersion": "8.4",
        "tailwindCSS.includeLanguages": {
          "vue": "html"
        }
      }
    }
  }
}
